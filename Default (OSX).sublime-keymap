[
  {
    "keys": ["super+shift+g"], "command": "show_overlay", "args":
    {
        "overlay": "command_palette",
        "text":"git"
    }
  },
  { "keys": ["ctrl+space"], "command": "auto_complete" },
  { "keys": ["alt+super+b"], "command": "auto_complete" },
  { "keys": ["f3"], "command": "find_next" },
  { "keys": ["shift+f3"], "command": "find_prev" },
  { "keys": ["ctrl+;"], "command": "show_overlay", "args": {"overlay": "goto", "text": "#"} },
  { "keys": ["shift+super+0"], "command": "reset_font_size"},

  // Swap bracket type
  {
    "keys": ["ctrl+shift+]"],
    "command": "swap_brackets"
  },

  // Swap quotes (only goes boths ways in supported languages...)
  {
    "keys": ["ctrl+shift+'"],
    "command": "bh_key",
    "args": {"lines" : true, "plugin": {"type": ["single_quote", "double_quote", "py_single_quote", "py_double_quote"], "command": "bh_modules.swapquotes"} }
  },

  // Select text between brackets
  {
    "keys": ["ctrl+alt+a"],
    "command": "bh_key",
    "args": {"lines" : true, "plugin": {"type": ["__all__"], "command": "bh_modules.bracketselect"} }
  },

  // Reset f5 to sort and make ctrl+f5 date panel
  { "keys": ["f5"], "command": "sort_lines" },

  { "keys": ["super+f5", "super+f5"], "command": "insert_date", "args": {"format": "%Y-%m-%d"}},
  { "keys": ["super+f5", "super+f6"], "command": "insert_date", "args": {"format": "%H:%M:%S"}},
  { "keys": ["super+f5", "super+f7"], "command": "insert_date", "args": {"format": "iso"}},

  // Toggle high visibility mode
  { "keys": ["alt+super+="], "command": "bh_toggle_high_visibility"},

  // Toggle markdown view
  {
    "keys": ["super+k", "m", "d"],
    "command": "set_file_type",
    "args": {"syntax": "Packages/Markdown/Markdown.sublime-syntax"}
  },

  // Toggle bash view
  {
    "keys": ["super+k", "s", "h"],
    "command": "set_file_type",
    "args": {"syntax": "Packages/ShellScript/Bash.sublime-syntax"}
  },


  // Toggle yaml view
  {
    "keys": ["super+k", "y", "q"],
    "command": "set_file_type",
    "args": {"syntax": "Packages/YAML/YAML.sublime-syntax"}
  },

  // Toggle terraform view
  {
    "keys": ["super+k", "t", "f"],
    "command": "set_file_type",
    "args": {"syntax": "Packages/Terraform/Terraform.sublime-syntax"}
  },

  // Run Json macro
  {
    "keys": ["super+k", "j", "q"],
    "command": "run_macro_file",
    "args": {"file": "Packages/User/set-json.sublime-macro"}
  },

  // Show in sidebar
  { "keys": ["super+alt+r"], "command": "reveal_in_side_bar" },

  // copilot
  {
    "keys": ["alt+space"],
    "command": "copilot_accept_completion",
    "context": [
      {
        "key": "copilot.is_on_completion"
      }
    ]
  },
  {
    "keys": [
      "alt+shift+space"
    ],
    "command": "copilot_get_panel_completions",
    "context": [
      {
        "key": "setting.copilot.completion.is_visible"
      }
    ]
  },
  // sendcode
  {
    "keys": ["super+alt+enter"], "command": "send_code",
    "context": [
        { "key": "selector", "operator": "equal", "operand": "source" }
    ]
  },
  {
    "keys": ["super+alt+enter"], "command": "send_code",
    "context": [
        { "key": "selector", "operator": "equal", "operand": "markup.raw.code-fence.markdown, markup.raw.block.fenced.markdown" }
    ]
  },
  {
    "keys": ["super+g","super+g"], "command": "send_code",
    "args": {"cmd": "gemini ask \"$selection\""},
  },
  {
    "keys": ["super+g","super+e"], "command": "send_code",
    "args": {"cmd": "gemini ask \"please explain the contents of this file: @$file\""},
  },
]

